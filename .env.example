# Copier en .env et remplir. Le .env n'est jamais commité (.gitignore).

# --- Obligatoire ---
# discord.com/developers/applications → ton app → Bot → Reset Token
DISCORD_TOKEN=

# --- Assistant vocal (/ecoute) ---
# console.groq.com/keys — sans cette clé, /ecoute est désactivé, le reste marche
GROQ_API_KEY=

# Serveur de voix Piper (local : .piper\venv\Scripts\python -m piper.http_server -m .piper\fr_FR-upmc-medium.onnx)
PIPER_URL=http://localhost:5000

# --- Optionnel : changer de cerveau (API compatible OpenAI) ---
# Par défaut Groq + qwen/qwen3.8-27b (gpt-oss-20b refuse trop, en anglais). Exemple OpenRouter :
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemma-4-31b-it:free
#LLM_BASE_URL=
#LLM_API_KEY=
#LLM_MODEL=

# --- Optionnel : changer de reconnaissance vocale ---
# Par défaut Groq + whisper-large-v3-turbo
#STT_BASE_URL=
#STT_API_KEY=
#STT_MODEL=

# --- Logs ---
# Défaut : warn,ratus=info — pour déboguer la voix : warn,ratus=info,songbird=debug
#RUST_LOG=
